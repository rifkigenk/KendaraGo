# ==========================================================
# 01. CONTOH KONFIGURASI LINGKUNGAN
# Salin ke .env lalu sesuaikan secret, koneksi database, batas unggahan, dan keamanan.
# ==========================================================

SECRET_KEY=ganti_dengan_hasil_secrets_token_hex_32
# Gunakan secret terpisah di produksi; minimal 32 karakter acak.
WTF_CSRF_SECRET_KEY=ganti_dengan_secret_csrf_acak_yang_berbeda
DATABASE_URL=mysql+pymysql://root:@localhost/db_kendarago
APP_ENV=development
MAX_CONTENT_LENGTH=2097152
MAX_FILE_SIZE=2097152
MAX_FORM_MEMORY_SIZE=262144
MAX_FORM_PARTS=100
WHATSAPP_NUMBER=6282282026127
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
FORCE_HTTPS=false
TRUSTED_HOSTS=127.0.0.1,localhost,::1
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
PAYMENT_DEADLINE_HOURS=2
APP_TIMEZONE=Asia/Jakarta

# Meta WhatsApp Cloud API - aktifkan setelah migrasi dan konfigurasi selesai.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Isi versi Graph API yang didukung dari dashboard Meta (format vNN.0).
WHATSAPP_API_VERSION=
WHATSAPP_PUBLIC_URL=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=id
